{
  "name": "bunker-dos-mortos-launcher",
  "productName": "Dead Bunker",
  "version": "1.2.1",
  "private": true,
  "description": "Launcher do Dead Bunker: baixa e atualiza o jogo, e abre numa janela própria.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.draxx46.bunkerdosmortos.launcher",
    "productName": "Dead Bunker",
    "files": [
      "main.js",
      "preload.js",
      "gamepreload.js",
      "index.html",
      "renderer.js",
      "img/**",
      "video/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "BunkerLauncher-Setup.exe",
      "shortcutName": "Dead Bunker",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Dead Bunker",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
